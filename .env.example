# Read by `./run` and by docker compose. Plain KEY=value, no quoting.
DATABASE_URL=postgres://postgres:postgres@localhost:5435/vigil
PORT=4100
LOG_LEVEL=info
SESSION_TTL_DAYS=30
LOGIN_ATTEMPTS_PER_MINUTE=10
# The reverse proxy's address, comma-separated if several: an IP, a CIDR range, or loopback when
# it runs on this host. Its X-Forwarded-For is then believed and the login limit is per client.
# Empty, behind a proxy every client shares the proxy's budget. Never set it with no proxy.
TRUST_PROXY=
# The §6 caps. Configurable only so the test suite can exercise them without 100-event bodies.
MAX_EVENTS_PER_BATCH=100
MAX_STACK_BYTES=16384
MAX_CONTEXT_BYTES=8192

{
  // The one test that imports the client, to post its real payload at the real endpoint. It
  // reaches outside `server/`, which the build's `rootDir` forbids, so it is type-checked here and
  // left out of `tsconfig.json`. `./run check` runs both.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true
  },
  "include": ["tests/integration/client-wire.test.ts", "tests/integration/global-setup.ts"],
  "exclude": []
}
